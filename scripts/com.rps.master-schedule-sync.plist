<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hourly Master Schedule snapshot on the office Mac. Install:
    cp scripts/com.rps.master-schedule-sync.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.rps.master-schedule-sync.plist
  Log: ~/Library/Logs/rps-master-schedule.log
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.rps.master-schedule-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/rpsstudio2/Developer/rps-maintenance/scripts/master-schedule-hourly.sh</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/rpsstudio2/Library/Logs/rps-master-schedule.log</string>
  <key>StandardErrorPath</key><string>/Users/rpsstudio2/Library/Logs/rps-master-schedule.log</string>
</dict>
</plist>
